datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  GUEST
  USER
  TRUSTED
  JUDGE
  ORGANIZER
  ADMIN
}

enum DeckFormat {
  WBO_COUNTERDECK
  THREE_ON_THREE
  PICK_THREE_CHOOSE_ONE
  ONE_ON_ONE
}

enum Country {
  DE
  AT
  CH
}

enum PrivacyLevel {
  PUBLIC
  FRIENDS_ONLY
  PRIVATE
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  BLOCKED
}

enum BeyType {
  ATTACK
  DEFENSE
  STAMINA
  BALANCE
}

enum AccountStatus {
  ACTIVE
  PENDING_PARENTAL_CONSENT
}

// Phase 5 Part A — parts catalog. BeyType above (Phase 1) is reused for Part.beyType.
enum Manufacturer {
  TT
  HASBRO
}

enum PartCategory {
  BLADE
  RATCHET
  BIT
  ACCESSORY
}

enum SpinDirection {
  RIGHT
  LEFT
}

// Phase 11 — catalog proposals replace PartRequest (free-text) with a structured shape
// covering a new Part OR a new official Build/Set in one model.
enum ProposalKind {
  PART
  BUILD
}

enum ProposalStatus {
  PENDING
  APPROVED
  REJECTED
}

// Phase 5 Part C — tournament match lifecycle for bracket/judge flow.
enum MatchStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

// Phase 5 Part C2 — multi-format tournaments: one Tournament runs 1+ ordered stages.
enum TournamentFormat {
  SINGLE_ELIMINATION
  DOUBLE_ELIMINATION
  SWISS
  ROUND_ROBIN // Phase 5 Part C3: every participant meets every other participant (1–3×)
}

enum StageStatus {
  PENDING
  ACTIVE
  COMPLETED
}

// Only meaningful when the stage's format = DOUBLE_ELIMINATION.
enum BracketSide {
  WINNERS
  LOSERS
  GRAND_FINAL
}

model User {
  id           String  @id @default(uuid())
  username     String  @unique
  passwordHash String?
  email        String?
  role         Role    @default(USER)

  displayName           String?
  // Phase 19: collision-checked form of displayName (trim().toLowerCase().normalize('NFKC')),
  // written in the same write as displayName itself (lib/displayName.ts). Nullable — multiple
  // NULLs are allowed in a unique index, so users without a display name never collide.
  displayNameNormalized String?   @unique
  birthDate             DateTime?
  // RC14 #17 — interface language (bare code from lib/i18n/locales.ts's SUPPORTED_LOCALES,
  // default de). Resolved per request in lib/i18n/server.ts; NOT a Prisma enum so adding a
  // language stays a code-only change (the locale registry is the single source of truth).
  language              String    @default("de")
  country               Country   @default(DE)
  state                 String?
  postalCode            String?
  city                  String?
  latitude              Float?
  longitude             Float?
  discordTag            String?
  bio                   String?

  profileVisibility    PrivacyLevel @default(PUBLIC)
  locationVisibility   PrivacyLevel @default(FRIENDS_ONLY) // was PUBLIC — Art. 25 privacy-by-default
  collectionVisibility PrivacyLevel @default(PUBLIC)
  decksVisibility      PrivacyLevel @default(PUBLIC)
  ageVisibility        PrivacyLevel @default(PRIVATE) // spec §2.D: "Alter" is privacy-controlled

  notifyRadiusKm            Int?               @default(50)
  notifyRecurring           Boolean            @default(false) // was true — opt-in, not opt-out
  notifyEmail               Boolean            @default(false)
  // Phase 18 — granular match/arena-lifecycle toggles, separate from the blanket notifyEmail
  // above (which stays the toggle for the nearby-tournament radius blast and club activity —
  // narrowing this phase's scope to the categories its own triggers actually add; a full
  // per-category rebuild of every existing notification type is a larger, separate task).
  // notifyMatchLifecycle gates PUSH for "Turnier gestartet"/"Gehe zu Arena N"/"Dein nächstes
  // Match beginnt" — default true (matches are time-sensitive; in-app always shows regardless
  // of this flag, it only gates the OS-level push send). notifyMatchLifecycleEmail is the
  // separate, conservative-default (false) email toggle for the same three triggers — keeps
  // the existing minor-ceiling rule (never emailed to an isMinor user, same as notifyEmail).
  notifyMatchLifecycle      Boolean            @default(true)
  notifyMatchLifecycleEmail Boolean            @default(false)
  pushSubscriptions         PushSubscription[]

  totpSecret String?
  passkeys   Passkey[]

  // [REVIEW-FIX: backend-security #50] session-revocation counter: bumped on GDPR erasure and
  // TOTP deactivation (and, by contract, any future password-change route), stamped into every
  // new JWT as the `tv` claim and re-checked on every request — a token minted before the bump
  // stops authenticating immediately instead of living out its 30 days.
  tokenVersion Int       @default(0)

  collection    CollectionItem[]
  decks         Deck[]
  tournaments   TournamentParticipant[]
  judgedMatches Match[]                 @relation("JudgeMatches")
  createdRules  Ruleset[]
  notifications Notification[]

  sentFriendRequests     Friendship[] @relation("SentFriends")
  receivedFriendRequests Friendship[] @relation("ReceivedFriends")

  ownedClubs           Club[]            @relation("ClubOwner")
  clubMemberships      ClubMember[]
  organizedTournaments Tournament[]      @relation("TournamentOrganizer")
  judgedTournaments    TournamentJudge[]
  ratings              Rating[]
  // Phase 11: submitted catalog proposals die with the account (Cascade);
  // reviewedById is SetNull so a reviewer's erasure never takes their reviews with them.
  catalogProposals     CatalogProposal[] @relation("CatalogProposalSubmitter")
  reviewedProposals    CatalogProposal[] @relation("CatalogProposalReviewer")
  // No mediaAssets relation here — MediaAsset.uploadedById is a plain String (see that
  // model's own comment), not a FK, so it never appears as a Prisma relation on User.
  // Phase 21: the user's own profile photo IS a real FK (onDelete: SetNull — the DB severs
  // the reference if the asset ever goes), unlike uploadedById. The SetNull is only the
  // backstop: account erasure (lib/accountErasure.ts) explicitly deletes the avatar's
  // MediaAsset row + on-volume file first — an avatar is personal-only data, it must not
  // survive its owner's erasure as an orphan.
  avatarImage   MediaAsset? @relation("UserAvatar", fields: [avatarImageId], references: [id], onDelete: SetNull)
  avatarImageId String?
  stageStandings       StageStanding[]
  // RC15 #12 — teams the user created (captain-by-default membership is a TeamMember row) and
  // the 3-vs-3 team rosters / tournament lineups they belong to. TeamMember cascades with the
  // account (a roster slot simply opens); TeamTournamentSlot rows survive erasure like
  // TournamentParticipant (opponents' match history is Art. 17(3) data — see accountErasure).
  createdTeams         Team[]                @relation("TeamCreator")
  teamMemberships      TeamMember[]
  teamSlots            TeamTournamentSlot[]
  // Phase 14 — real FK (not a plain String like AuditLog.actorId/MediaAsset.uploadedById):
  // account erasure ANONYMIZES the User row in place (lib/accountErasure.ts), it never hard-
  // deletes it, so this FK never actually cascades in practice — kept as a real relation
  // purely so the leaderboard/profile queries can `include: { user: true }` directly instead
  // of a manual join. Documented per the plan's own note to decide this at implementation time.
  playerRatings        PlayerRating[]

  // Additive fields, none in spec §3 — required for GDPR Art. 8 (minors) and Art. 7 (consent evidence):
  isMinor                 Boolean       @default(true) // computed at registration from birthDate; safe-by-default
  parentalConsentEmail    String?
  parentalConsentAt       DateTime?
  privacyPolicyAcceptedAt DateTime?
  privacyPolicyVersion    String?
  status                  AccountStatus @default(ACTIVE) // minors start PENDING_PARENTAL_CONSENT (Task 5)

  createdAt DateTime @default(now())
}

model Passkey {
  id           String @id @default(uuid())
  userId       String
  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialId String @unique
  publicKey    String
  counter      Int
}

model Friendship {
  id          String           @id @default(uuid())
  requesterId String
  requester   User             @relation("SentFriends", fields: [requesterId], references: [id], onDelete: Cascade)
  addresseeId String
  addressee   User             @relation("ReceivedFriends", fields: [addresseeId], references: [id], onDelete: Cascade)
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())

  @@unique([requesterId, addresseeId])
  // RC7 (#36): inbox listing filters by status for the addressee (pending requests view).
  @@index([status, addresseeId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  // RC7 (#36): hot per-user path — inbox list & SSE stream query
  // where: { userId }, orderBy: { createdAt: 'desc' }.
  @@index([userId, createdAt])
}

// Phase 18 — Web Push subscriptions. A user may have several (one per device/browser); each is
// keyed by its unique push `endpoint` (the browser-assigned URL identifying that subscription),
// upserted on (re-)subscribe. Purely personal data — Cascade with the account, no erasure-
// matrix entry needed beyond the existing Cascade backstop (unlike AuditLog/MediaAsset, a push
// endpoint has no value to anyone but its owner).
model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

// Phase 13: join policies. OPEN = today's behavior (immediate join); APPLICATION = self-service
// POST creates a PENDING_APPLICATION row an admin must approve; INVITE_ONLY = no self-service
// join at all — only owner/admins create PENDING_INVITE rows, and only the invitee may accept.
enum ClubJoinPolicy {
  OPEN
  APPLICATION
  INVITE_ONLY
}

// Phase 13: mirrors Friendship's PENDING/ACCEPTED shape. Default ACTIVE keeps every existing
// ClubMember row behaviorally unchanged; pending rows must never inflate counts, rosters, or
// isAdmin authz checks (every query filters to ACTIVE).
enum ClubMemberStatus {
  ACTIVE
  PENDING_APPLICATION
  PENDING_INVITE
}

model Club {
  id          String         @id @default(uuid())
  name        String         @unique
  slug        String         @unique
  description String?
  websiteUrl  String? // Phase 13 — optional profile links
  discordUrl  String?
  joinPolicy  ClubJoinPolicy @default(OPEN) // Phase 13 — OPEN preserves pre-Phase-13 behavior
  ownerId     String
  owner       User           @relation("ClubOwner", fields: [ownerId], references: [id])
  members     ClubMember[]
  tournaments Tournament[]
  // RC15 #12 — a Club MAY have competitive 3-vs-3 teams ("Club X Team A"); teams survive their
  // club's dissolution (SetNull), a club never owns its teams' lifecycle.
  teams       Team[]
  // Phase 12: capped chat stream (max 50 messages, enforced synchronously on insert) —
  // messages die with the club (onDelete: Cascade).
  messages    ClubMessage[]
  createdAt   DateTime       @default(now())
}

model ClubMember {
  id       String           @id @default(uuid())
  clubId   String
  club     Club             @relation(fields: [clubId], references: [id], onDelete: Cascade)
  userId   String
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  isAdmin  Boolean          @default(false)
  status   ClubMemberStatus @default(ACTIVE) // Phase 13 — see the enum's audit note
  joinedAt DateTime         @default(now())

  @@unique([clubId, userId])
}

// Phase 12: club chat message. authorId is a plain String, NOT a User FK (same reasoning as
// AuditLog.actorId): a message must survive its author's account erasure (Art. 17), showing an
// anonymized "gelöschter Nutzer" attribution instead of breaking — never cascade-delete a
// user's messages on account deletion (that would let a user retroactively erase chat history
// other members already read).
model ClubMessage {
  id        String   @id @default(uuid())
  clubId    String
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  authorId  String
  body      String // bio-convention free-text cap (500), enforced in the route
  createdAt DateTime @default(now())

  @@index([clubId, createdAt])
}

model Ruleset {
  id          String  @id @default(uuid())
  title       String
  slug        String  @unique
  description String?
  isPublic    Boolean @default(true)
  createdById String
  createdBy   User    @relation(fields: [createdById], references: [id])

  deckFormat               DeckFormat @default(WBO_COUNTERDECK)
  targetPoints             Int        @default(4)
  finalsTargetPoints       Int        @default(7)
  lockedDecks              Boolean    @default(true)
  allowForceSwitch         Boolean    @default(true)
  arenaTurnAllowed         Boolean    @default(true)
  outOfBounds2Pts          Boolean    @default(true)
  ownFinishPenalty         Boolean    @default(true)
  relaunchLimit            Int        @default(1)
  aerialContactRerun       Boolean    @default(true)
  // [Phase 2, REVIEW-FIX: ux-product §5] spec §2.B lists "äußere Störungen" (external
  // disturbance → rematch) as a special rule but spec §3's schema never gave it a column —
  // additive gap-closer, per Global Constraints.
  externalDisturbanceRerun Boolean    @default(true)

  tournaments Tournament[]
}

model Tournament {
  id          String    @id @default(uuid())
  title       String
  description String
  startDate   DateTime
  endDate     DateTime?

  locationName String
  street       String?
  postalCode   String
  city         String
  state        String
  country      Country @default(DE)
  latitude     Float
  longitude    Float

  entryFeeCent  Int     @default(0)
  currency      String  @default("EUR")
  isRecurring   Boolean @default(false)
  recurringDays Int?

  rulesetId String
  ruleset   Ruleset @relation(fields: [rulesetId], references: [id])

  clubId String?
  club   Club?   @relation(fields: [clubId], references: [id])

  createdById String
  createdBy   User   @relation("TournamentOrganizer", fields: [createdById], references: [id])

  // Phase 5 Part C — "Turnier abschließen" from the organizer console; null while running.
  completedAt DateTime?
  // Phase 16 — "Turnier starten", a one-way organizer action distinct from completedAt and
  // NOT inferred from startDate (explicit user decision). When set, and the linked Ruleset has
  // lockedDecks: true, every participant's deck builds are snapshotted into
  // TournamentParticipant.lockedBuildIds in the same transaction — see that field's own comment.
  startedAt   DateTime?

  // Phase 11 — event header image via the generic media pipeline (item 0); rendered full-width
  // on the detail page and as a list-card thumbnail on /events.
  headerImageId String?
  headerImage   MediaAsset? @relation("TournamentHeaderImage", fields: [headerImageId], references: [id], onDelete: SetNull)
  // Phase 7 — QR-Workflows & Zahlungsverfolgung: organizer-configured count of physical
  // arenas/stadiums at the venue; null = no arena management (matches get no arenaNumber).
  arenaCount    Int?
  // Phase 7 — server-issued, event-scoped token for the QR self-service check-in. The bare
  // tournament id must never be accepted as a check-in credential, hence a per-event uuid.
  checkInToken  String      @unique @default(uuid())

  // Phase 14 — an organizer can opt a casual/friendly/test event out of Elo impact. Defaults
  // to true (ranked) so every ALREADY-RUN tournament starts counting once this phase ships —
  // they were run as real competitive events, so that's the correct default, not a silent
  // retroactive change of intent (see the plan's own note).
  rankedEligible Boolean @default(true)

  // RC15 #12 — MVP3 3-vs-3 team competition (WBO Masters League parity). Registration is
  // "one team, three players' decks" via TeamTournamentEntry instead of solo
  // TournamentParticipant rows; bracket nodes are TeamMatch encounters (best-of-3 over three
  // slot-vs-slot sub-matches). Immutable once any registration exists (route-enforced).
  teamMode Boolean @default(false)

  participants TournamentParticipant[]
  matches      Match[]
  judges       TournamentJudge[]
  // Phase 5 Part C2 — the tournament's ordered stages (each with its own format/bracket).
  stages       TournamentStage[]
  teamEntries  TeamTournamentEntry[]
  teamMatches  TeamMatch[]

  // RC7 (#36): public listing/filter queries — club calendar and country-filtered event list,
  // both ordered by startDate.
  @@index([clubId, startDate])
  @@index([country, startDate])
}

// Phase 14 — Ranked Ladder & Elo Rating System. One Season is ACTIVE at a time (enforced in
// app/api/admin/seasons/route.ts, not at the DB level — a DB-level partial unique index on a
// boolean-ish status would work in raw Postgres but Prisma has no portable way to express it
// declaratively without a raw migration; the admin-only creation route is the sole write path
// so app-level enforcement is sufficient here).
enum SeasonStatus {
  ACTIVE
  COMPLETED
}

model Season {
  id       String         @id @default(uuid())
  name     String // organizer-facing label, e.g. "Season 1 – Frühjahr 2026"
  startsAt DateTime
  endsAt   DateTime
  status   SeasonStatus   @default(ACTIVE)
  ratings  PlayerRating[]

  @@index([status])
}

model PlayerRating {
  id          String   @id @default(uuid())
  seasonId    String
  season      Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  elo         Int      @default(1000)
  peakElo     Int      @default(1000)
  gamesPlayed Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@unique([seasonId, userId])
  @@index([seasonId, elo])
}

model TournamentParticipant {
  id             String     @id @default(uuid())
  tournamentId   String
  tournament     Tournament @relation(fields: [tournamentId], references: [id])
  userId         String
  user           User       @relation(fields: [userId], references: [id])
  deckId         String?
  deck           Deck?      @relation(fields: [deckId], references: [id])
  checkedIn      Boolean    @default(false)
  // Phase 5 Part C — no-show handling from the organizer console: a withdrawn participant is
  // skipped by bracket generation and, if their match already exists, the opponent is
  // auto-advanced.
  withdrawn      Boolean    @default(false)
  // Phase 7 — Zahlungsverfolgung: null = entry fee unpaid; timestamp lets the organizer
  // console show when the payment was recorded.
  paidAt         DateTime?
  // Phase 15 — bracket seeding. null = "use the organizer's chosen auto method" (rating-based
  // or shuffle); a lower number is a better bracket position (seed 1 = top seed). A manually-
  // set seed always wins over auto-assignment for that participant (mixed manual+auto is a
  // real, supported case). Only consulted by the FIRST stage's generation — later stages seed
  // from their own qualification order, not this field (see lib/seeding.ts's own comment).
  seed           Int?
  // Phase 16 — populated from Deck.builds at the moment Tournament.startedAt is set (only when
  // the tournament's Ruleset has lockedDecks: true) — a SNAPSHOT, not a live reference. The
  // live Deck stays freely editable by its owner afterward (it's a personal, reusable object
  // that may be registered for other, not-yet-started tournaments); this array is what becomes
  // authoritative for THIS tournament's matches from that point on. Empty = no snapshot taken
  // (tournament not yet started, or its ruleset doesn't lock decks).
  lockedBuildIds String[]   @default([])

  @@unique([tournamentId, userId])
  // RC7 (#36): "all tournaments of a user" (profile page, account export) — the @@unique above
  // starts with tournamentId, so it can't serve it.
  @@index([userId])
}

// Phase 7 — additional judges for a tournament (besides the creator): the QR check-in /
// arena-console flows accept judge actions from any user in this join. Composite PK mirrors
// TournamentParticipant's @@unique([tournamentId, userId]).
model TournamentJudge {
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@id([tournamentId, userId])
}

// Phase 5 Part C2 — a tournament stage: one ordered, independently-formatted segment of a
// tournament (e.g. "Vorrunde" SWISS → "Playoffs" DOUBLE_ELIMINATION). Every Match belongs to
// exactly one stage; a stage's round numbering restarts at 1.
model TournamentStage {
  id                String           @id @default(uuid())
  tournamentId      String
  tournament        Tournament       @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  order             Int // 1-based sequence within the tournament
  name              String // organizer-facing label, e.g. "Vorrunde", "Playoffs"
  format            TournamentFormat
  status            StageStatus      @default(PENDING)
  swissRounds       Int? // SWISS only: total planned rounds, set at stage creation
  swissRoundsDone   Int              @default(0)
  // Phase 5 Part C3 — ROUND_ROBIN only: how many times each pair meets (1, 2, or 3; null/omitted
  // defaults to 1 at the route layer, no DB default so the organizer's actual choice is recorded).
  roundRobinRepeats Int?
  qualifyCount      Int? // how many top participants advance to the NEXT stage; null on the last stage
  // Populated by the stage-complete route: the previous stage's top `qualifyCount` userIds, read
  // by the generate route as this stage's participant pool (NOT a new join model, per plan).
  qualifiedUserIds  String[]         @default([])

  matches   Match[]
  standings StageStanding[]
  // RC15 #12 — team-mode bracket nodes for this stage (TeamMatch); solo matches stay [].
  teamMatches TeamMatch[]

  @@unique([tournamentId, order])
}

// Phase 5 Part C2 — per-stage, per-player record: Swiss wins/losses/buchholz + played-against
// history (Swiss pairing must not repeat a pairing), double-elimination elimination state.
model StageStanding {
  id          String          @id @default(uuid())
  stageId     String
  stage       TournamentStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  wins        Int             @default(0)
  losses      Int             @default(0)
  buchholz    Float           @default(0) // tiebreak: sum of opponents' win counts at time of pairing
  opponentIds String[]        @default([]) // played-against history — Swiss pairing must not repeat a pairing
  // Swiss only: how many byes this player has received in this stage — a player never gets two
  // byes in one stage. (Additive column beyond the plan's literal StageStanding sketch; the plan
  // REQUIRES bye tracking but its sketch has no field for it — documented deviation.)
  byes        Int             @default(0)
  eliminated  Boolean         @default(false) // DOUBLE_ELIMINATION only: true after a 2nd loss

  @@unique([stageId, userId])
}

// Part (Phase 5 Part A, [REVIEW-FIX: backend-security #5, performance P12]) — the curated parts
// catalog. Phase 11 replaced the free-text imageUrl column with a real FK to MediaAsset (the
// generic upload pipeline): one owned asset per image, served by /api/media/[id].
model Part {
  id            String        @id @default(uuid())
  name          String
  manufacturer  Manufacturer
  category      PartCategory
  beyType       BeyType?
  spinDirection SpinDirection
  // Phase 16 — current-gen CX-series dual-spin parts: when true, `spinDirection` above is only
  // the SUGGESTED/default mode — the actual in-match mode is chosen per match (Match.player1SpinMode
  // / player2SpinMode) and locked at build confirmation, per the real WBO rulebook procedure.
  dualSpin      Boolean       @default(false)
  weightGrams   Float?
  imageId       String?
  image         MediaAsset?   @relation("PartImage", fields: [imageId], references: [id], onDelete: SetNull)
  metadata      Json?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  buildsBlade     Build[]          @relation("BuildBlade")
  buildsRatchet   Build[]          @relation("BuildRatchet")
  buildsBit       Build[]          @relation("BuildBit")
  collectionItems CollectionItem[]

  @@index([category, name])
}

// CatalogProposal (Phase 11, replaces PartRequest) — any logged-in user proposes a new Part or
// official Build/Set; TRUSTED/JUDGE/ORGANIZER/ADMIN review. payload is validated by kind at the
// route layer (lib/proposalValidation.ts, extending lib/partValidation.ts's pattern), never
// accepted as opaque JSON. imageAssetId is an optional MediaAsset uploaded with the proposal.
model CatalogProposal {
  id            String         @id @default(uuid())
  kind          ProposalKind
  submittedById String
  submittedBy   User           @relation("CatalogProposalSubmitter", fields: [submittedById], references: [id], onDelete: Cascade)
  payload       Json
  imageAssetId  String?
  imageAsset    MediaAsset?    @relation("CatalogProposalImage", fields: [imageAssetId], references: [id], onDelete: SetNull)
  status        ProposalStatus @default(PENDING)
  reviewedById  String?
  reviewedBy    User?          @relation("CatalogProposalReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewNote    String?
  createdAt     DateTime       @default(now())
  reviewedAt    DateTime?

  @@index([status, createdAt])
}

model Build {
  id        String  @id @default(uuid())
  bladeId   String
  blade     Part    @relation("BuildBlade", fields: [bladeId], references: [id], onDelete: Restrict)
  ratchetId String
  ratchet   Part    @relation("BuildRatchet", fields: [ratchetId], references: [id], onDelete: Restrict)
  bitId     String
  bit       Part    @relation("BuildBit", fields: [bitId], references: [id], onDelete: Restrict)
  type      BeyType @default(ATTACK)

  // Phase 11 — official Sets: `name` is the retail product name (nullable — a user-created
  // combo has no single official name); isOfficialSet marks curated retail products (created
  // via CatalogProposal approval or the curator direct-create path, never by POST /api/builds);
  // imageId is the Set photo via the media pipeline. Builds stay catalog rows without a user
  // FK — a user's personal combo is just a non-official Build.
  name          String?
  isOfficialSet Boolean     @default(false)
  imageId       String?
  image         MediaAsset? @relation("BuildImage", fields: [imageId], references: [id], onDelete: SetNull)
  // Manufacturer retail product/SKU code for an official Set (e.g. Hasbro "F9580", Takara Tomy
  // "BX-01") — printed on the box, distinct from our own internal `id`. Only meaningful for
  // isOfficialSet: true; a user's personal combo has no product code. Unique when present so
  // the same retail SKU can't be catalogued twice, but nullable since older/non-official rows
  // and not-yet-researched Sets have none.
  productCode String? @unique

  ratings                Rating[]
  deckBuilds             DeckBuild[]
  matchesP1              Match[]          @relation("Player1Build")
  matchesP2              Match[]          @relation("Player2Build")
  // Phase 11 — provenance for collection rows created by "Set als gekauft markieren".
  sourcedCollectionItems CollectionItem[] @relation("CollectionItemSourceBuild")

  // Phase 20 — the same three parts can never back two Build rows; every creation path
  // pre-checks the combo and returns the existing Build's id gracefully.
  @@unique([bladeId, ratchetId, bitId])
  @@index([bladeId])
  @@index([ratchetId])
  @@index([bitId])
}

model Deck {
  id          String                  @id @default(uuid())
  title       String
  userId      String
  user        User                    @relation(fields: [userId], references: [id])
  builds      DeckBuild[]
  tournaments TournamentParticipant[]
  // RC15 #12 — team-mode lineup slots reference a member's deck (SetNull mirrors the solo
  // TournamentParticipant.deck treatment).
  teamSlots   TeamTournamentSlot[]

  // RC7 (#36): per-user deck list.
  @@index([userId])
}

model DeckBuild {
  deckId   String
  deck     Deck   @relation(fields: [deckId], references: [id], onDelete: Cascade)
  buildId  String
  build    Build  @relation(fields: [buildId], references: [id])
  position Int

  // [Phase 5 Part A, REVIEW-FIX: backend-security #1] position is the row's identity within a
  // deck; the same build may appear at most ONCE per deck — the DB itself enforces it, so a
  // racing/malicious client can't bypass application-level deck validation.
  @@id([deckId, position])
  @@unique([deckId, buildId])
}

model Match {
  id           String          @id @default(uuid())
  tournamentId String
  tournament   Tournament      @relation(fields: [tournamentId], references: [id])
  // Phase 5 Part C2 — every match belongs to exactly one stage (required FK; no production rows
  // predate stages per the plan's backward-compat note). tournamentId is deliberately KEPT as a
  // denormalized second FK so all Part C authz/scoring call sites keep reading match.tournament.*
  // directly instead of a stage→tournament two-hop. Stage deletion cascades to its matches.
  stageId      String
  stage        TournamentStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  judgeId      String?
  judge        User?           @relation("JudgeMatches", fields: [judgeId], references: [id])

  // Phase 5 Part C — nullable (documented additive deviation from spec §3's required form):
  // empty future-round bracket slots are persisted at generation time and filled when the
  // predecessor match completes (score route propagates the winner) or via no-show auto-advance.
  player1Id       String?
  player2Id       String?
  player1BuildId  String?
  player1Build    Build?         @relation("Player1Build", fields: [player1BuildId], references: [id])
  player2BuildId  String?
  player2Build    Build?         @relation("Player2Build", fields: [player2BuildId], references: [id])
  // Phase 16 — only meaningful when the confirmed build for that player contains at least one
  // dualSpin part; locked at the same moment player1BuildId/player2BuildId are confirmed
  // (match start, before the first score) and immutable after — the score route rejects (409)
  // any attempt to change it once status is IN_PROGRESS or later.
  player1SpinMode SpinDirection?
  player2SpinMode SpinDirection?

  scorePlayer1 Int     @default(0)
  scorePlayer2 Int     @default(0)
  winnerId     String?

  // Phase 5 Part C — bracket/round placement and lifecycle (all additive):
  round         Int          @default(0) // 1 = first bracket round, counts up to the final; 0/unused for SWISS
  bracketOrder  Int          @default(0) // position within a round; feeds match slot (i+1)/2 in round+1
  status        MatchStatus  @default(PENDING)
  // Phase 5 Part C2 — stage-scoped placement. bracketSide is only set for DOUBLE_ELIMINATION
  // stages; swissRound only for SWISS stages (distinct from `round`, which stays the
  // elimination-bracket round number and restarts at 1 per stage).
  bracketSide   BracketSide?
  swissRound    Int?
  // Idempotency key for offline-synced scores: one client-generated UUID per judge action, unique
  // DB-wide — a replayed POST with the same clientEventId is a server-side no-op.
  clientEventId String?      @unique

  // Phase 7 — arena/stadium assignment: which physical arena the match plays on (1..arenaCount);
  // null = unassigned (waiting for the dynamic pass after another match frees its arena).
  arenaNumber             Int?
  // Phase 7 — QR self-service check-in: when each player scanned the arena QR and confirmed
  // their presence; null until checked in.
  player1ArenaCheckedInAt DateTime?
  player2ArenaCheckedInAt DateTime?

  // RC15 #12 — set when this match is a TEAM-MODE sub-game: one slot-vs-slot game of a
  // TeamMatch encounter (best-of-3). Sub-games are judged with the regular solo machinery
  // (score route, JudgeScorePad) but never bracket/standings/Elo on their own — their
  // completion feeds the parent encounter (lib/teamStage.ts). Null = a regular solo match.
  teamMatchId String?
  teamMatch   TeamMatch? @relation(fields: [teamMatchId], references: [id], onDelete: Cascade)

  @@index([tournamentId, round, bracketOrder])
  @@index([stageId, round, bracketOrder])
}

// ─── RC15 #12 — MVP3 3-vs-3 team competition (WBO Masters League parity) ───────────────
// Deliberately a SEPARATE aggregate from Club (master-plan MVP3 decision): Club = persistent
// social community; Team = competitive roster of exactly 3 players, optionally club-affiliated
// via the nullable clubId. Lifecycle differences (ad-hoc per event vs. persistent) are why a
// repurposed Club would break one of the two use cases.
enum TeamRole {
  CAPTAIN
  MEMBER
}

model Team {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  // Nullable FK per the MVP3 sketch: a team MAY be club-affiliated ("Club X Team A") or stand
  // alone. SetNull — the team survives its club's dissolution.
  clubId      String?
  club        Club?    @relation(fields: [clubId], references: [id], onDelete: SetNull)
  createdById String
  createdBy   User     @relation("TeamCreator", fields: [createdById], references: [id])
  members     TeamMember[]
  entries     TeamTournamentEntry[]
  createdAt   DateTime @default(now())
}

// A team's roster. Capped at 3 ACTIVE members by the route layer (TeamTournamentEntry's
// unique pair with the @@id([entryId, position]) below make the roster the lineup: a team
// registers for a team tournament with exactly its 3 members, one per slot).
model TeamMember {
  id       String   @id @default(uuid())
  teamId   String
  team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     TeamRole @default(MEMBER)
  joinedAt DateTime @default(now())

  @@unique([teamId, userId])
  // "my teams" listing (profile/team pages, registration pickers).
  @@index([userId])
}

// A team's registration for ONE team-mode tournament. Mirrors TournamentParticipant's shape
// (checkedIn/withdrawn/seed) so the organizer-console and generation flows stay symmetric.
model TeamTournamentEntry {
  id           String     @id @default(uuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  teamId       String
  team         Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  checkedIn    Boolean    @default(false)
  // No-show handling, mirroring TournamentParticipant.withdrawn: skipped by bracket generation.
  withdrawn    Boolean    @default(false)
  // Phase-15-style seed placeholder for future team seeding; null = deterministic id order.
  seed         Int?
  createdAt    DateTime   @default(now())
  slots        TeamTournamentSlot[]
  // Both sides of every TeamMatch this entry plays in the tournament.
  teamMatches1 TeamMatch[] @relation("TeamMatchSide1")
  teamMatches2 TeamMatch[] @relation("TeamMatchSide2")

  @@unique([tournamentId, teamId])
  @@index([tournamentId, checkedIn])
}

// One lineup slot of a TeamTournamentEntry: position 1..3. Encounter games pair slot i of
// team 1 against slot i of team 2 (fixed order — no captain-order shenanigans in v1).
model TeamTournamentSlot {
  entryId  String
  entry    TeamTournamentEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  position Int // 1..3 — (entryId, position) is the row's identity within the lineup (cf. DeckBuild)
  userId   String
  user     User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  deckId   String?
  deck     Deck?               @relation(fields: [deckId], references: [id], onDelete: SetNull)
  // Phase-16-style snapshot of this slot's deck builds at "Turnier starten" (only when the
  // linked Ruleset locks decks) — same snapshot-not-live-reference contract as
  // TournamentParticipant.lockedBuildIds. Empty = no snapshot.
  lockedBuildIds String[]      @default([])

  @@id([entryId, position])
  @@unique([entryId, userId])
}

// A team-vs-team ENCOUNTER: the bracket node in team mode. Groups exactly three sub-Match
// rows (Match.teamMatchId, one per lineup slot); the encounter is a BEST-OF-3 over those
// games — first team to 2 game wins takes the encounter and advances in the bracket. The
// bracket-shape columns mirror Match so the elimination pure libs (lib/bracket.ts,
// lib/doubleElimination.ts) and ranking logic apply unchanged.
model TeamMatch {
  id           String          @id @default(uuid())
  tournamentId String
  tournament   Tournament      @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  stageId      String
  stage        TournamentStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  team1EntryId String?
  team1Entry   TeamTournamentEntry? @relation("TeamMatchSide1", fields: [team1EntryId], references: [id], onDelete: Cascade)
  team2EntryId String?
  team2Entry   TeamTournamentEntry? @relation("TeamMatchSide2", fields: [team2EntryId], references: [id], onDelete: Cascade)

  round        Int          @default(0) // same semantics as Match.round (1-based per stage)
  bracketOrder Int          @default(0)
  bracketSide  BracketSide? // DOUBLE_ELIMINATION only, same as Match.bracketSide
  status       MatchStatus  @default(PENDING)
  // Running sub-game win counts (first to 2 ends the encounter; the third game only plays
  // when the first two split).
  winsTeam1    Int          @default(0)
  winsTeam2    Int          @default(0)
  winnerEntryId String?

  games Match[]

  @@index([stageId, round, bracketOrder])
  @@index([tournamentId])
}

model CollectionItem {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  partOrBeyId   String
  part          Part      @relation(fields: [partOrBeyId], references: [id], onDelete: Restrict)
  purchasePrice Float?
  currency      String    @default("EUR")
  merchant      String?
  boughtAt      DateTime?

  // Phase 11 — provenance only: "this part entry came from buying Set X" (item 6). Not a new
  // ownership unit — the three rows created by marking a Set purchased stay independently
  // editable/deletable. SetNull so deleting a catalog Build never blocks collection edits.
  sourceBuildId String?
  sourceBuild   Build?  @relation("CollectionItemSourceBuild", fields: [sourceBuildId], references: [id], onDelete: SetNull)

  pricePoints PricePoint[]

  @@index([partOrBeyId])
  // RC7 (#36): per-user collection list.
  @@index([userId])
}

// MediaAsset (Phase 11, item 0) — ONE generic owned-asset model behind every image upload.
// Files live on the bind-mounted `media_uploads:` volume (container FS is ephemeral under
// Watchtower redeploys — never the writable layer) and are served by /api/media/[id].
// filename is the ORIGINAL client filename (provenance); the stored file on disk is always
// "<id>.webp" after the sharp resize+WebP normalization.
// MediaAsset.uploadedById is a plain String, NOT a User FK — same reasoning as
// AuditLog.actorId/ClubMessage.authorId: a real catalog image (a Part/Build/Tournament's
// picture) must survive its uploader's account being erased under Art. 17 (a stranger
// deleting their own account must never make an unrelated catalog photo disappear).
// Erasure severs the reference (see lib/accountErasure.ts) rather than deleting the row.
model MediaAsset {
  id           String   @id @default(uuid())
  filename     String
  mimeType     String
  width        Int
  height       Int
  sizeBytes    Int
  uploadedById String
  createdAt    DateTime @default(now())

  parts       Part[]            @relation("PartImage")
  builds      Build[]           @relation("BuildImage")
  tournaments Tournament[]      @relation("TournamentHeaderImage")
  proposals   CatalogProposal[] @relation("CatalogProposalImage")
  // Phase 21: users whose current profile photo is this asset (User.avatarImageId,
  // onDelete: SetNull — deleting the asset nulls the user's reference, never the user).
  avatars     User[]            @relation("UserAvatar")
}

// PricePoint (Phase 5 Part B, [REVIEW-FIX: ux-product §3d, spec §5 Phase 5 "Preisverlauf"]) —
// additional price observations for an owned CollectionItem over time (insurance/resale
// tracking). Cascade: dies with its CollectionItem at the DB level; the account-erasure matrix
// ALSO deletes it explicitly before the parent, self-documenting per the Cross-Phase
// Regression Guard's standing erasure rule.
model PricePoint {
  id               String         @id @default(uuid())
  collectionItemId String
  collectionItem   CollectionItem @relation(fields: [collectionItemId], references: [id], onDelete: Cascade)
  price            Float
  currency         String         @default("EUR")
  recordedAt       DateTime       @default(now())

  @@index([collectionItemId, recordedAt])
}

// Rating (Phase 5 Part A fix, [REVIEW-FIX: backend-security #1 "Rating has no userId"]) —
// one rating per user per build (@@unique([buildId, userId])), so edit/delete-your-own and
// abuse attribution work at all. Cascade: a user's ratings die with their account (the erasure
// matrix also deletes them explicitly — this is the backstop).
model Rating {
  id        String   @id @default(uuid())
  buildId   String
  build     Build    @relation(fields: [buildId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stars     Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([buildId, userId])
  @@index([buildId, createdAt])
}

// AuditLog (Phase 4, [REVIEW-FIX: privacy-dsgvo #8]) — append-only record of privileged
// mutations (role changes, club-member kicks, account deletions, later judge-score overrides).
// Rows are never updated or deleted. actorId/targetId are plain strings, NOT foreign keys:
// an audit trail must outlive the rows it references (account erasure anonymizes the user row
// in place, and hard-delete cleanup paths must never be blocked by the log).
model AuditLog {
  id         String   @id @default(uuid())
  actorId    String
  action     String
  targetType String
  targetId   String
  summary    String
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
  @@index([actorId, createdAt])
}
