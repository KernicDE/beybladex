datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  GUEST
  USER
  TRUSTED
  JUDGE
  ORGANIZER
  ADMIN
}

enum DeckFormat {
  WBO_COUNTERDECK
  THREE_ON_THREE
  PICK_THREE_CHOOSE_ONE
  ONE_ON_ONE
}

enum Country {
  DE
  AT
  CH
}

enum PrivacyLevel {
  PUBLIC
  FRIENDS_ONLY
  PRIVATE
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  BLOCKED
}

enum BeyType {
  ATTACK
  DEFENSE
  STAMINA
  BALANCE
}

enum AccountStatus {
  ACTIVE
  PENDING_PARENTAL_CONSENT
}

// Phase 5 Part A — parts catalog. BeyType above (Phase 1) is reused for Part.beyType.
enum Manufacturer {
  TT
  HASBRO
}

enum PartCategory {
  BLADE
  RATCHET
  BIT
  ACCESSORY
}

enum SpinDirection {
  RIGHT
  LEFT
}

enum PartRequestStatus {
  PENDING
  RESOLVED
  REJECTED
}

// Phase 5 Part C — tournament match lifecycle for bracket/judge flow.
enum MatchStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

// Phase 5 Part C2 — multi-format tournaments: one Tournament runs 1+ ordered stages.
enum TournamentFormat {
  SINGLE_ELIMINATION
  DOUBLE_ELIMINATION
  SWISS
  ROUND_ROBIN // Phase 5 Part C3: every participant meets every other participant (1–3×)
}

enum StageStatus {
  PENDING
  ACTIVE
  COMPLETED
}

// Only meaningful when the stage's format = DOUBLE_ELIMINATION.
enum BracketSide {
  WINNERS
  LOSERS
  GRAND_FINAL
}

model User {
  id                   String         @id @default(uuid())
  username             String         @unique
  passwordHash         String?
  email                String?
  role                 Role           @default(USER)

  displayName          String?
  birthDate            DateTime?
  country              Country        @default(DE)
  state                String?
  postalCode           String?
  city                 String?
  latitude             Float?
  longitude            Float?
  discordTag           String?
  bio                  String?

  profileVisibility    PrivacyLevel   @default(PUBLIC)
  locationVisibility   PrivacyLevel   @default(FRIENDS_ONLY) // was PUBLIC — Art. 25 privacy-by-default
  collectionVisibility PrivacyLevel   @default(PUBLIC)
  decksVisibility      PrivacyLevel   @default(PUBLIC)
  ageVisibility        PrivacyLevel   @default(PRIVATE) // spec §2.D: "Alter" is privacy-controlled

  notifyRadiusKm       Int?           @default(50)
  notifyRecurring      Boolean        @default(false) // was true — opt-in, not opt-out
  notifyEmail          Boolean        @default(false)

  totpSecret           String?
  passkeys             Passkey[]

  collection           CollectionItem[]
  decks                Deck[]
  tournaments          TournamentParticipant[]
  judgedMatches        Match[]        @relation("JudgeMatches")
  createdRules         Ruleset[]
  notifications        Notification[]

  sentFriendRequests     Friendship[] @relation("SentFriends")
  receivedFriendRequests Friendship[] @relation("ReceivedFriends")

  ownedClubs           Club[]         @relation("ClubOwner")
  clubMemberships      ClubMember[]
  organizedTournaments Tournament[]   @relation("TournamentOrganizer")
  ratings              Rating[]
  partRequests         PartRequest[]
  stageStandings       StageStanding[]

  // Additive fields, none in spec §3 — required for GDPR Art. 8 (minors) and Art. 7 (consent evidence):
  isMinor                 Boolean        @default(true) // computed at registration from birthDate; safe-by-default
  parentalConsentEmail    String?
  parentalConsentAt       DateTime?
  privacyPolicyAcceptedAt DateTime?
  privacyPolicyVersion    String?
  status                  AccountStatus  @default(ACTIVE) // minors start PENDING_PARENTAL_CONSENT (Task 5)

  createdAt            DateTime       @default(now())
}

model Passkey {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialId String   @unique
  publicKey    String
  counter      Int
}

model Friendship {
  id          String           @id @default(uuid())
  requesterId String
  requester   User             @relation("SentFriends", fields: [requesterId], references: [id], onDelete: Cascade)
  addresseeId String
  addressee   User             @relation("ReceivedFriends", fields: [addresseeId], references: [id], onDelete: Cascade)
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())

  @@unique([requesterId, addresseeId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

// Phase 13: join policies. OPEN = today's behavior (immediate join); APPLICATION = self-service
// POST creates a PENDING_APPLICATION row an admin must approve; INVITE_ONLY = no self-service
// join at all — only owner/admins create PENDING_INVITE rows, and only the invitee may accept.
enum ClubJoinPolicy {
  OPEN
  APPLICATION
  INVITE_ONLY
}

// Phase 13: mirrors Friendship's PENDING/ACCEPTED shape. Default ACTIVE keeps every existing
// ClubMember row behaviorally unchanged; pending rows must never inflate counts, rosters, or
// isAdmin authz checks (every query filters to ACTIVE).
enum ClubMemberStatus {
  ACTIVE
  PENDING_APPLICATION
  PENDING_INVITE
}

model Club {
  id          String         @id @default(uuid())
  name        String         @unique
  slug        String         @unique
  description String?
  websiteUrl  String? // Phase 13 — optional profile links
  discordUrl  String?
  joinPolicy  ClubJoinPolicy @default(OPEN) // Phase 13 — OPEN preserves pre-Phase-13 behavior
  ownerId     String
  owner       User           @relation("ClubOwner", fields: [ownerId], references: [id])
  members     ClubMember[]
  tournaments Tournament[]
  // Phase 12: capped chat stream (max 50 messages, enforced synchronously on insert) —
  // messages die with the club (onDelete: Cascade).
  messages    ClubMessage[]
  createdAt   DateTime       @default(now())
}

model ClubMember {
  id        String           @id @default(uuid())
  clubId    String
  club      Club             @relation(fields: [clubId], references: [id], onDelete: Cascade)
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  isAdmin   Boolean          @default(false)
  status    ClubMemberStatus @default(ACTIVE) // Phase 13 — see the enum's audit note
  joinedAt  DateTime         @default(now())

  @@unique([clubId, userId])
}

// Phase 12: club chat message. authorId is a plain String, NOT a User FK (same reasoning as
// AuditLog.actorId): a message must survive its author's account erasure (Art. 17), showing an
// anonymized "gelöschter Nutzer" attribution instead of breaking — never cascade-delete a
// user's messages on account deletion (that would let a user retroactively erase chat history
// other members already read).
model ClubMessage {
  id        String   @id @default(uuid())
  clubId    String
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  authorId  String
  body      String   // bio-convention free-text cap (500), enforced in the route
  createdAt DateTime @default(now())

  @@index([clubId, createdAt])
}

model Ruleset {
  id                  String       @id @default(uuid())
  title               String
  slug                String       @unique
  description         String?
  isPublic            Boolean      @default(true)
  createdById         String
  createdBy           User         @relation(fields: [createdById], references: [id])

  deckFormat          DeckFormat   @default(WBO_COUNTERDECK)
  targetPoints        Int          @default(4)
  finalsTargetPoints  Int          @default(7)
  lockedDecks         Boolean      @default(true)
  allowForceSwitch    Boolean      @default(true)
  arenaTurnAllowed    Boolean      @default(true)
  outOfBounds2Pts     Boolean      @default(true)
  ownFinishPenalty    Boolean      @default(true)
  relaunchLimit       Int          @default(1)
  aerialContactRerun  Boolean      @default(true)
  // [Phase 2, REVIEW-FIX: ux-product §5] spec §2.B lists "äußere Störungen" (external
  // disturbance → rematch) as a special rule but spec §3's schema never gave it a column —
  // additive gap-closer, per Global Constraints.
  externalDisturbanceRerun Boolean @default(true)

  tournaments         Tournament[]
}

model Tournament {
  id              String                  @id @default(uuid())
  title           String
  description     String
  startDate       DateTime
  endDate         DateTime?

  locationName    String
  street          String?
  postalCode      String
  city            String
  state           String
  country         Country                 @default(DE)
  latitude        Float
  longitude       Float

  entryFeeCent    Int                     @default(0)
  currency        String                  @default("EUR")
  isRecurring     Boolean                 @default(false)
  recurringDays   Int?

  rulesetId       String
  ruleset         Ruleset                 @relation(fields: [rulesetId], references: [id])

  clubId          String?
  club            Club?                   @relation(fields: [clubId], references: [id])

  createdById     String
  createdBy       User                    @relation("TournamentOrganizer", fields: [createdById], references: [id])

  // Phase 5 Part C — "Turnier abschließen" from the organizer console; null while running.
  completedAt     DateTime?

  participants    TournamentParticipant[]
  matches         Match[]
  // Phase 5 Part C2 — the tournament's ordered stages (each with its own format/bracket).
  stages          TournamentStage[]
}

model TournamentParticipant {
  id           String     @id @default(uuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id])
  userId       String
  user         User       @relation(fields: [userId], references: [id])
  deckId       String?
  deck         Deck?      @relation(fields: [deckId], references: [id])
  checkedIn    Boolean    @default(false)
  // Phase 5 Part C — no-show handling from the organizer console: a withdrawn participant is
  // skipped by bracket generation and, if their match already exists, the opponent is
  // auto-advanced.
  withdrawn    Boolean    @default(false)

  @@unique([tournamentId, userId])
}

// Phase 5 Part C2 — a tournament stage: one ordered, independently-formatted segment of a
// tournament (e.g. "Vorrunde" SWISS → "Playoffs" DOUBLE_ELIMINATION). Every Match belongs to
// exactly one stage; a stage's round numbering restarts at 1.
model TournamentStage {
  id              String            @id @default(uuid())
  tournamentId    String
  tournament      Tournament        @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  order           Int               // 1-based sequence within the tournament
  name            String            // organizer-facing label, e.g. "Vorrunde", "Playoffs"
  format          TournamentFormat
  status          StageStatus       @default(PENDING)
  swissRounds     Int?              // SWISS only: total planned rounds, set at stage creation
  swissRoundsDone Int               @default(0)
  // Phase 5 Part C3 — ROUND_ROBIN only: how many times each pair meets (1, 2, or 3; null/omitted
  // defaults to 1 at the route layer, no DB default so the organizer's actual choice is recorded).
  roundRobinRepeats Int?
  qualifyCount    Int?              // how many top participants advance to the NEXT stage; null on the last stage
  // Populated by the stage-complete route: the previous stage's top `qualifyCount` userIds, read
  // by the generate route as this stage's participant pool (NOT a new join model, per plan).
  qualifiedUserIds String[]         @default([])

  matches         Match[]
  standings       StageStanding[]

  @@unique([tournamentId, order])
}

// Phase 5 Part C2 — per-stage, per-player record: Swiss wins/losses/buchholz + played-against
// history (Swiss pairing must not repeat a pairing), double-elimination elimination state.
model StageStanding {
  id          String          @id @default(uuid())
  stageId     String
  stage       TournamentStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  wins        Int             @default(0)
  losses      Int             @default(0)
  buchholz    Float           @default(0)   // tiebreak: sum of opponents' win counts at time of pairing
  opponentIds String[]        @default([])  // played-against history — Swiss pairing must not repeat a pairing
  // Swiss only: how many byes this player has received in this stage — a player never gets two
  // byes in one stage. (Additive column beyond the plan's literal StageStanding sketch; the plan
  // REQUIRES bye tracking but its sketch has no field for it — documented deviation.)
  byes        Int             @default(0)
  eliminated  Boolean         @default(false) // DOUBLE_ELIMINATION only: true after a 2nd loss

  @@unique([stageId, userId])
}

// Part (Phase 5 Part A, [REVIEW-FIX: backend-security #5, performance P12]) — the curated parts
// catalog. imageUrl points at a file under /public/parts/ (admin/TRUSTED-curated, a few hundred
// files; no upload pipeline at this scale) and is always rendered via next/image with explicit
// sizes/width/height.
model Part {
  id            String          @id @default(uuid())
  name          String
  manufacturer  Manufacturer
  category      PartCategory
  beyType       BeyType?
  spinDirection SpinDirection
  weightGrams   Float?
  imageUrl      String?
  metadata      Json?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  buildsBlade   Build[]         @relation("BuildBlade")
  buildsRatchet Build[]         @relation("BuildRatchet")
  buildsBit     Build[]         @relation("BuildBit")
  collectionItems CollectionItem[]

  @@index([category, name])
}

// PartRequest (Phase 5 Part A) — "request missing part" flow: any logged-in user can ask for a
// part the catalog doesn't have yet; it lands in an admin/TRUSTED queue.
model PartRequest {
  id                String            @id @default(uuid())
  requestedById     String
  requestedBy       User              @relation(fields: [requestedById], references: [id], onDelete: Cascade)
  name              String
  manufacturerGuess Manufacturer?
  notes             String?
  status            PartRequestStatus @default(PENDING)
  createdAt         DateTime          @default(now())

  @@index([status, createdAt])
}

model Build {
  id          String   @id @default(uuid())
  bladeId     String
  blade       Part     @relation("BuildBlade", fields: [bladeId], references: [id], onDelete: Restrict)
  ratchetId   String
  ratchet     Part     @relation("BuildRatchet", fields: [ratchetId], references: [id], onDelete: Restrict)
  bitId       String
  bit         Part     @relation("BuildBit", fields: [bitId], references: [id], onDelete: Restrict)
  type        BeyType  @default(ATTACK)

  ratings     Rating[]
  deckBuilds  DeckBuild[]
  matchesP1   Match[]  @relation("Player1Build")
  matchesP2   Match[]  @relation("Player2Build")

  @@index([bladeId])
  @@index([ratchetId])
  @@index([bitId])
}

model Deck {
  id          String                  @id @default(uuid())
  title       String
  userId      String
  user        User                    @relation(fields: [userId], references: [id])
  builds      DeckBuild[]
  tournaments TournamentParticipant[]
}

model DeckBuild {
  deckId   String
  deck     Deck   @relation(fields: [deckId], references: [id], onDelete: Cascade)
  buildId  String
  build    Build  @relation(fields: [buildId], references: [id])
  position Int

  // [Phase 5 Part A, REVIEW-FIX: backend-security #1] position is the row's identity within a
  // deck; the same build may appear at most ONCE per deck — the DB itself enforces it, so a
  // racing/malicious client can't bypass application-level deck validation.
  @@id([deckId, position])
  @@unique([deckId, buildId])
}

model Match {
  id             String      @id @default(uuid())
  tournamentId   String
  tournament     Tournament  @relation(fields: [tournamentId], references: [id])
  // Phase 5 Part C2 — every match belongs to exactly one stage (required FK; no production rows
  // predate stages per the plan's backward-compat note). tournamentId is deliberately KEPT as a
  // denormalized second FK so all Part C authz/scoring call sites keep reading match.tournament.*
  // directly instead of a stage→tournament two-hop. Stage deletion cascades to its matches.
  stageId        String
  stage          TournamentStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  judgeId        String?
  judge          User?       @relation("JudgeMatches", fields: [judgeId], references: [id])

  // Phase 5 Part C — nullable (documented additive deviation from spec §3's required form):
  // empty future-round bracket slots are persisted at generation time and filled when the
  // predecessor match completes (score route propagates the winner) or via no-show auto-advance.
  player1Id      String?
  player2Id      String?
  player1BuildId String?
  player1Build   Build?      @relation("Player1Build", fields: [player1BuildId], references: [id])
  player2BuildId String?
  player2Build   Build?      @relation("Player2Build", fields: [player2BuildId], references: [id])

  scorePlayer1   Int         @default(0)
  scorePlayer2   Int         @default(0)
  winnerId       String?

  // Phase 5 Part C — bracket/round placement and lifecycle (all additive):
  round          Int         @default(0) // 1 = first bracket round, counts up to the final; 0/unused for SWISS
  bracketOrder   Int         @default(0) // position within a round; feeds match slot (i+1)/2 in round+1
  status         MatchStatus @default(PENDING)
  // Phase 5 Part C2 — stage-scoped placement. bracketSide is only set for DOUBLE_ELIMINATION
  // stages; swissRound only for SWISS stages (distinct from `round`, which stays the
  // elimination-bracket round number and restarts at 1 per stage).
  bracketSide    BracketSide?
  swissRound     Int?
  // Idempotency key for offline-synced scores: one client-generated UUID per judge action, unique
  // DB-wide — a replayed POST with the same clientEventId is a server-side no-op.
  clientEventId  String?     @unique

  @@index([tournamentId, round, bracketOrder])
  @@index([stageId, round, bracketOrder])
}

model CollectionItem {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  partOrBeyId   String
  part          Part      @relation(fields: [partOrBeyId], references: [id], onDelete: Restrict)
  purchasePrice Float?
  currency      String    @default("EUR")
  merchant      String?
  boughtAt      DateTime?

  pricePoints   PricePoint[]

  @@index([partOrBeyId])
}

// PricePoint (Phase 5 Part B, [REVIEW-FIX: ux-product §3d, spec §5 Phase 5 "Preisverlauf"]) —
// additional price observations for an owned CollectionItem over time (insurance/resale
// tracking). Cascade: dies with its CollectionItem at the DB level; the account-erasure matrix
// ALSO deletes it explicitly before the parent, self-documenting per the Cross-Phase
// Regression Guard's standing erasure rule.
model PricePoint {
  id               String         @id @default(uuid())
  collectionItemId String
  collectionItem   CollectionItem @relation(fields: [collectionItemId], references: [id], onDelete: Cascade)
  price            Float
  currency         String         @default("EUR")
  recordedAt       DateTime       @default(now())

  @@index([collectionItemId, recordedAt])
}

// Rating (Phase 5 Part A fix, [REVIEW-FIX: backend-security #1 "Rating has no userId"]) —
// one rating per user per build (@@unique([buildId, userId])), so edit/delete-your-own and
// abuse attribution work at all. Cascade: a user's ratings die with their account (the erasure
// matrix also deletes them explicitly — this is the backstop).
model Rating {
  id        String   @id @default(uuid())
  buildId   String
  build     Build    @relation(fields: [buildId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stars     Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([buildId, userId])
  @@index([buildId, createdAt])
}

// AuditLog (Phase 4, [REVIEW-FIX: privacy-dsgvo #8]) — append-only record of privileged
// mutations (role changes, club-member kicks, account deletions, later judge-score overrides).
// Rows are never updated or deleted. actorId/targetId are plain strings, NOT foreign keys:
// an audit trail must outlive the rows it references (account erasure anonymizes the user row
// in place, and hard-delete cleanup paths must never be blocked by the log).
model AuditLog {
  id         String   @id @default(uuid())
  actorId    String
  action     String
  targetType String
  targetId   String
  summary    String
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
  @@index([actorId, createdAt])
}
