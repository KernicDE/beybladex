DATABASE_URL="postgresql://beybladex:devpass@localhost:5432/beybladex_dev"
REDIS_URL="redis://localhost:6379"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="dev-secret-change-me"
WEBAUTHN_RP_ID="localhost"
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Must decode to exactly 32 bytes — the previous example value was 34 bytes and crashed AES-256-GCM.
TOTP_ENCRYPTION_KEY="EYNd27+y+waQG7aQScKAHypWJevMkS1wUMcwXHJNhWg="
# Outgoing mail (lib/mailer.ts — self-hosted SMTP, no third-party SaaS mailer per the plan's
# privacy-first stance). Dev/CI placeholders; production values come from the operator's own
# mail host (kernic.net). If SMTP_HOST is unset, lib/mailer.ts logs-and-noops instead of sending.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
# Shared secret for POST /api/internal/cleanup-notifications (retention purge). An external
# cron (system crontab on the deploy server or a scheduled CI workflow) sends this as the
# `x-cron-secret` header. Generate with: openssl rand -hex 32
INTERNAL_CRON_SECRET="dev-cron-secret-change-me"
# Web Push (Phase 18 — lib/webPush.ts). The Push API itself is a browser-native standard, no
# third-party push-relay SaaS involved (browsers route through their own vendor's push service,
# same as every site's Web Push — not something this app can avoid or replace). Generate a real
# pair ONCE per environment with: node -e "console.log(require('web-push').generateVAPIDKeys())"
# — the public key is also read client-side (NEXT_PUBLIC_ prefix) to register a subscription; the
# private key must stay server-only. If VAPID_PRIVATE_KEY is unset, lib/webPush.ts logs-and-noops
# (same degrade-gracefully convention as lib/mailer.ts's SMTP_HOST check).
NEXT_PUBLIC_VAPID_PUBLIC_KEY="BB8w5X3J9-_KJLTvH3Bbl21BVmC6XMRP1z8X_qM668qtsTyIMUkkUo-DgOeew6NvOd1tm9vC-EfFpDhS12fQaHM"
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@beybladex.de"

# ---- Deploy-server keys (consumed by compose.yml, NOT by local development) ----
# The standing no-local-Docker policy means local dev never runs compose.yml.
# These keys are interpolated by compose.yml on the deploy server
# (/opt/docker/beybladex/app-beybladex on nicolas@kernic.net) from a real .env placed next
# to compose.yml —
# never committed, readable only by the deploy user.
DB_PASSWORD="dev-db-password-change-me"
# Production NEXTAUTH_SECRET, WEBAUTHN_RP_ID (beybladex.de), TOTP_ENCRYPTION_KEY,
# the SMTP_* values above, and a production VAPID key pair (generated once, never rotated
# casually — rotating invalidates every existing browser subscription) are also required in
# that server-side .env.
