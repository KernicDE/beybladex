# Outgoing mail (lib/mailer.ts — self-hosted SMTP, no third-party SaaS mailer per the plan's
# privacy-first stance). Dev/CI placeholders; production values come from the operator's own
# mail host (kernic.net). If SMTP_HOST is unset, lib/mailer.ts logs-and-noops instead of sending.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
# Shared secret for POST /api/internal/cleanup-notifications (retention purge). An external
# cron (system crontab on the deploy server or a scheduled CI workflow) sends this as the
# `x-cron-secret` header. Generate with: openssl rand -hex 32
INTERNAL_CRON_SECRET="dev-cron-secret-change-me"
