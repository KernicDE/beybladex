DATABASE_URL="postgresql://beybladex:devpass@localhost:5432/beybladex_dev"
REDIS_URL="redis://localhost:6379"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="dev-secret-change-me"
WEBAUTHN_RP_ID="localhost"
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Must decode to exactly 32 bytes — the previous example value was 34 bytes and crashed AES-256-GCM.
TOTP_ENCRYPTION_KEY="EYNd27+y+waQG7aQScKAHypWJevMkS1wUMcwXHJNhWg="
# Outgoing mail (lib/mailer.ts — self-hosted SMTP, no third-party SaaS mailer per the plan's
# privacy-first stance). Dev/CI placeholders; production values come from the operator's own
# mail host (kernic.net). If SMTP_HOST is unset, lib/mailer.ts logs-and-noops instead of sending.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
# Shared secret for POST /api/internal/cleanup-notifications (retention purge). An external
# cron (system crontab on the deploy server or a scheduled CI workflow) sends this as the
# `x-cron-secret` header. Generate with: openssl rand -hex 32
INTERNAL_CRON_SECRET="dev-cron-secret-change-me"

# ---- Deploy-server keys (consumed by compose.yml, NOT by local development) ----
# The standing no-local-Docker policy means local dev never runs compose.yml.
# These keys are interpolated by compose.yml on the deploy server
# (/opt/docker/beybladex/baybladex) from a real .env placed next to compose.yml —
# never committed, readable only by the deploy user.
DB_PASSWORD="dev-db-password-change-me"
# Production NEXTAUTH_SECRET, WEBAUTHN_RP_ID (beybladex.de), TOTP_ENCRYPTION_KEY,
# and the SMTP_* values above are also required in that server-side .env.
